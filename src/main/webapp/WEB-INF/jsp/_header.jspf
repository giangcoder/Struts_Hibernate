<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="s" uri="/struts-tags" %>
<!doctype html>
<html lang="vi">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Hồ sơ Web</title>
  <link rel="stylesheet" href="<s:url value='/assets/app.css'/>">
</head>
<body>
<header class="topbar">
  <a class="brand" href="<s:url action='projects'/>"><span class="logo-dot"></span>Hồ sơ Web</a>
  <s:if test="uid != null">
    <nav class="top-actions">
      <a href="<s:url action='projects'/>">Dự án</a>
      <span class="muted user"><s:property value="userName"/></span>
      <form method="post" action="<s:url action='logout'/>" class="inline">
        <input type="hidden" name="csrf" value="<s:property value='csrf'/>">
        <button class="link" type="submit">Đăng xuất</button>
      </form>
    </nav>
  </s:if>
</header>
<main class="container">
<s:iterator value="flashMessages"><div class="flash ok"><s:property/></div></s:iterator>
<s:iterator value="flashErrors"><div class="flash err"><s:property/></div></s:iterator>

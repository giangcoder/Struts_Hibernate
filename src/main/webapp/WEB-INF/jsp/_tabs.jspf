<div class="project-head">
  <div class="ph-main">
    <s:if test="project.logoUrl != null"><img class="ph-logo" src="<s:property value='project.logoUrl'/>" alt=""></s:if>
    <div>
      <h1><s:property value="project.brandName"/></h1>
      <div class="muted small">
        <s:if test="project.website != null"><a href="<s:property value='project.website'/>" target="_blank" rel="noopener noreferrer"><s:property value="project.website"/></a></s:if>
      </div>
    </div>
  </div>
  <div class="ph-progress">
    <div class="small"><b><s:property value="doneCount"/></b> / <s:property value="total"/> profile hoàn thành</div>
    <div class="bar"><span style="width: <s:property value='donePercent'/>%"></span></div>
  </div>
</div>
<nav class="steps">
  <a class="step done" href="<s:url action='projects'/>"><span class="n">✓</span>Dự án</a>
  <a class="step <s:if test='#tab == "info"'>on</s:if>" href="<s:url action='projectEdit'><s:param name='projectId' value='project.id'/></s:url>"><span class="n">2</span>Hồ sơ</a>
  <a class="step <s:if test='#tab == "list"'>on</s:if>" href="<s:url action='platforms'><s:param name='projectId' value='project.id'/></s:url>"><span class="n">3</span>Tạo profile</a>
  <a class="step <s:if test='#tab == "results" || #tab == "sinbyte"'>on</s:if>" href="<s:url action='results'><s:param name='projectId' value='project.id'/></s:url>"><span class="n">4</span>Kết quả</a>
</nav>
